---
import Base from '../layouts/Base.astro';
---

<Base title="This page does not exist" description="This page does not exist." path="/404" noindex>
  <div class="wrap" style="padding: 96px 0 128px;">
    <h1 style="font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.375rem);">This page does not exist</h1>
    <p class="lead">The address may be mistyped, or the page may have moved.</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn" href="/#lab">Open the demo index</a>
    </div>
  </div>
</Base>
